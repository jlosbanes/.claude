{
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "model": "opus",
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git_approval_gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
